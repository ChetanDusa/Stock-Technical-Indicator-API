# Local Compose defaults only. Production values go in the hosting dashboard.
DATABASE_URL=postgresql://stockapi:local-development-only@localhost:5432/stockapi
REDIS_URL=redis://localhost:6379/0
APP_ENV=development

# Neon: use the pooled URL above and the direct URL here for migrations.
# DATABASE_MIGRATION_URL=postgresql://ROLE:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Managed Redis: copy its TCP/TLS URL, not its REST endpoint.
# REDIS_URL=rediss://default:TOKEN@HOST:6379/0

PORT=8000
POLARS_MAX_THREADS=2
CACHE_DEFAULT_TTL=300
REDIS_KEY_PREFIX=stockapi
DEPENDENCY_TIMEOUT_SECONDS=5
DB_POOL_SIZE=5
SCREENING_MAX_CONCURRENCY=1
LOG_LEVEL=INFO
RUN_MIGRATIONS=1
